# 这是线上部署配置示例。请复制为服务器上的 .env，并按实际线上环境填写。
# 不要将填写了真实密码的 .env 提交到 Git 或分享给他人。

# 线上 ACR 仓库的完整地址，不含 https://，也不含 :api-xxx 或 :web-xxx 标签。
# 请从自己的 ACR 控制台复制仓库地址，替换下面的占位示例。
ACR_IMAGE=registry.example.com/your-namespace/your-repository

# 要部署版本的完整 Git 提交 SHA（40 位），该版本的 api-<SHA> 和 web-<SHA> 镜像须已推送至 ACR。
# 手动部署时填写真实 SHA；使用 release.sh 发布时，脚本会根据传入的 SHA 自动更新此值。
IMAGE_TAG=replace_with_git_commit_sha

# 线上 MySQL 的连接地址，格式为 主机名或IP:端口，必须能从 API 容器内访问。
# mysql:3306 仅适用于同一 Docker 网络中可通过 mysql 访问的数据库；否则请填写实际地址。
# 不要填 localhost 或 127.0.0.1，它们在 API 容器中指向容器自身。
DB_ADDR=mysql:3306

# 线上 MySQL 的实际用户
DB_USER=

# 线上数据库账号的真实密码
DB_PASSWORD=

# 线上数据库
DB_NAME=lesson06_demo

# 后台 admin 账号密码
ADMIN_PASSWORD=123456
